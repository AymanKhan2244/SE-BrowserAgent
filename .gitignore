# =============================================================
# .gitignore for TodoListApp
# =============================================================
# This file is generated automatically. It is intended to exclude
# all files and directories that should not be committed to version
# control for both the backend (Node/TypeScript) and the frontend
# (Vite + React + TypeScript) parts of the project.
# ------------------------------------------------------------
# General OS generated files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
# ------------------------------------------------------------
# Node.js / npm / Yarn / pnpm
# ------------------------------------------------------------
# Dependency directories
**/node_modules/
# Optional npm cache directory
.npm
# Optional yarn cache directory
.yarn
# Optional pnpm store directory
.pnpm-store
# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Production build output
**/dist/
**/build/
# TypeScript cache
**/*.tsbuildinfo
# Environment files
.env
.env.*
# Local IDE/editor settings
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
# ------------------------------------------------------------
# Backend specific
# ------------------------------------------------------------
# Compiled JavaScript (if any) and source maps
backend/**/*.js
backend/**/*.map
# Jest coverage
backend/coverage/
# Test reports
backend/junit.xml
# Logs specific to backend
backend/*.log
# Docker files generated at runtime
backend/*.pid
# Prisma (if used) – ignore generated client
backend/prisma/*.js
backend/prisma/*.ts
# ------------------------------------------------------------
# Frontend specific
# ------------------------------------------------------------
# Vite build output
frontend/dist/
# Static assets generated by the build process
frontend/.next/
# Local server logs
frontend/*.log
# Storybook (if present) build artifacts
frontend/storybook-static/
# Cypress screenshots & videos
frontend/cypress/screenshots/
frontend/cypress/videos/
# ------------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------------
# Lock files – keep them in repo, but ignore any stray ones
package-lock.json
yarn.lock
pnpm-lock.yaml
# ------------------------------------------------------------
# End of .gitignore
# ------------------------------------------------------------
